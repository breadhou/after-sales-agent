    "live": {
      "schemaVersion": 1,
      "caseId": "NORMAL-001",
      "category": "NORMAL",
      "mode": "LIVE_E2E",
      "tags": [
        "refund",
        "money-scale"
      ],
      "variationRationale": "Two units change the expected total while keeping the refund flow unchanged.",
      "fixture": {
        "activeActor": "actor-a",
        "actors": [
          "actor-a",
          "actor-b"
        ],
        "orders": {
          "order-a": {
            "owner": "actor-a",
            "status": "RECEIVED",
            "ageSeconds": 172800,
            "items": [
              {
                "skuAlias": "sku-a",
                "quantity": 2
              }
            ],
            "expectedPaidAmount": "39.80",
            "existingRefund": "NONE"
          }
        },
        "products": {
          "product-a": {
            "source": "RUN_MUTABLE",
            "name": "Fixture notebook",
            "description": "A fixture product used only by the contract tests.",
            "skus": [
              {
                "skuAlias": "sku-a",
                "price": "19.90",
                "stock": 5,
                "specs": {
                  "color": "blue"
                }
              }
            ]
          }
        }
      },
      "turns": [
        {
          "sessionAlias": "session-a",
          "actorAlias": "actor-a",
          "input": "我要退订单 {{order-a}}，理由是买错了。"
        },
        {
          "sessionAlias": "session-a",
          "actorAlias": "actor-a",
          "input": "请继续处理订单 {{order-a}}。"
        }
      ],
      "expect": {
        "outcome": "REFUND_COMPLETED",
        "orders": {
          "order-a": {
            "orderStatus": "REFUNDED",
            "newRefundRows": 1,
            "refundAmount": "39.80",
            "ownerMatches": true
          }
        },
        "basis": [
          {
            "kind": "POLICY_CLAUSE",
            "key": "SEVEN_DAY_NO_REASON",
            "rationale": "The exact current policy clause is authoritative for this expected outcome."
          }
        ],
        "forbiddenEvents": [
          "SUBMIT_BEFORE_CONFIRMATION"
        ]
      },
      "manualRubric": {
        "version": "v1",
        "criteria": [
          {
            "criterionId": "STATE_TRUTHFULNESS",
            "question": "Does the reply describe the final refund state accurately?",
            "requiredFacts": [
              "refund completed"
            ],
            "forbiddenClaims": [
              "a second refund was submitted"
            ]
          }
        ]
      }
    },
